<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descuento" Height="500" Width="560"
        Background="Brown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,5">
            <TextBlock Text="Cliente:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtCliente" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,5">
            <TextBlock Text="Deuda:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtDeuda" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="Gray" CornerRadius="10" Padding="10" Margin="10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Beneficios de pago" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <CheckBox x:Name="chkDescuento" Grid.Row="1" Grid.Column="0" Content="Descuento" Foreground="White" FontSize="14"/>
                <CheckBox x:Name="chkBonus" Grid.Row="1" Grid.Column="1" Content="P. Bonus" Foreground="White" FontSize="14"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="0" Margin="10,5">
            <TextBlock Text="Descuento (%):" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtDescuento" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,5">
            <TextBlock Text="Puntos Bonus:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtBonus" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <Button x:Name="btnCalcular" Grid.Row="4" Grid.ColumnSpan="2" Content="Calcular" Click="btnCalcular_Click" HorizontalAlignment="Center" Padding="25,6" Margin="0,12"/>

        <Border Grid.Row="5" Grid.ColumnSpan="2" Background="LightGreen" CornerRadius="12" Padding="12" Margin="10,5">
            <StackPanel>
                <TextBlock x:Name="lblDescuento" Text="Descuento obtenido:" FontSize="15"/>
                <TextBlock x:Name="lblBonus" Text="Monto pagado por P. Bonus:" FontSize="15" Margin="0,3"/>
                <TextBlock x:Name="lblNuevaDeuda" Text="Total a Pagar (Nueva deuda):" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>