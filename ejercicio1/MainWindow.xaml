<Window x:Class="WpfApplication1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="480" Width="560"
        Background="Brown">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Gray" Padding="5" Margin="0,0,0,10">
            <TextBlock Text="INFORMACION GENERAL" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,5">
            <TextBlock Text="Personal:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtPersonal" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5">
            <TextBlock Text="Codigo:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtCodigo" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,10">
            <TextBlock Text="Aportaciones:" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
            <CheckBox x:Name="chkFonavi" Content="Fonavi (8%)" Foreground="White" FontSize="14" Margin="0,3"/>
            <CheckBox x:Name="chkRenta" Content="Imp. Renta (5%)" Foreground="White" FontSize="14" Margin="0,3"/>
            <CheckBox x:Name="chkAfp" Content="A.F.P. (12%)" Foreground="White" FontSize="14" Margin="0,3"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,10">
            <TextBlock Text="Ingreso:" Foreground="White" FontSize="14"/>
            <Border Background="White" CornerRadius="12" Padding="10,0">
                <TextBox x:Name="txtIngreso" Background="Transparent" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center"/>
            </Border>
            <Button x:Name="btnCalcular" Content="Calcular" Click="btnCalcular_Click" HorizontalAlignment="Center" Padding="20,6" Margin="0,15,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="Gray" Padding="5" Margin="0,10">
            <TextBlock Text="RESULTADOS" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>

        <StackPanel Grid.Row="4" Grid.Column="0" Margin="10,5">
            <TextBlock x:Name="lblFonavi" Text="Fonavi:" Foreground="White" FontSize="15"/>
            <TextBlock x:Name="lblRenta" Text="Imp. Renta:" Foreground="White" FontSize="15"/>
            <TextBlock x:Name="lblAfp" Text="A.F.P.:" Foreground="White" FontSize="15"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,5">
            <TextBlock x:Name="lblTotal" Text="Total a Pagar:" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>